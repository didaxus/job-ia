{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "match_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "apply",
        "consider",
        "skip"
      ]
    },
    "genuine_gaps": {
      "type": "string"
    },
    "transferable_strengths": {
      "type": "string"
    },
    "risk_factors": {
      "type": "string"
    },
    "skill_inferences": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "required_skill": {
            "type": "string"
          },
          "evidence_text": {
            "type": "string"
          },
          "relation": {
            "type": "string",
            "enum": [
              "direct",
              "inferred",
              "unsupported"
            ]
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "required_skill",
          "evidence_text",
          "relation",
          "rationale"
        ]
      }
    }
  },
  "required": [
    "match_score",
    "recommendation",
    "genuine_gaps",
    "transferable_strengths",
    "risk_factors",
    "skill_inferences"
  ]
}
