# Leave empty to skip Claude evaluation. This API may incur charges.
ANTHROPIC_API_KEY=
# Use 80-100 for conservative matching; only scored jobs generate CVs.
FIT_MIN=80
MAX_AI_EVALUATIONS=20
SCAN_EVERY_HOURS=24
# Only for email routes verified/approved in config/approved_email_routes.yaml.
AUTO_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# V2 (set secret value directly in Coolify, never commit it)
JOBPILOT_DB_PASSWORD=
# Required for browser access in V2: signed Cloudflare Access JWT issuer + app AUD
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
JOBPILOT_PRIVATE_HOST_DIR=/srv/jobpilot-id/private
