# Plantilla informativa. Coolify gestiona las variables de ejecución;
# no es necesario cargar ni montar un archivo .env.
JOBPILOT_DB_PASSWORD=
JOBPILOT_PRIVATE_HOST_DIR=/srv/jobpilot-id/private
# Optional for reusing an existing on-host Codex session directory:
# JOBPILOT_CODEX_HOST_DIR=/srv/jobpilot-id/codex-home
MAX_CODEX_EVALUATIONS_PER_DAY=4
SCAN_EVERY_HOURS=24
AUTO_EMAIL=false

# La cuenta ChatGPT se vincula directamente en Codex CLI mediante device auth.
# La política de acceso externo ya se administra en Cloudflare Zero Trust.
